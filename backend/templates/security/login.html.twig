{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main>
        <h1>Connexion</h1>

        {% if error %}
            {# Message volontairement générique : on ne révèle pas si l'e-mail existe #}
            <p role="alert">Identifiants invalides. Vérifiez votre adresse e-mail et votre mot de passe.</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div>
                <label for="username">Adresse e-mail</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>

            <div>
                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Se connecter</button>
        </form>

        <p>Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
    </main>
{% endblock %}
